{
  "$schema": "./sources/schema.json",
  "family_name": "Maple Mono Px",
  "font_version": "8.002",
  "formats": [
    "ttf",
    "otf",
    "woff2"
  ],
  "use_hinted": false,
  "standard_zero": true,
  "pool_size": 4,
  "ttfautohint_param": {},
  "github_mirror": "github.com",
  "infinite_arrow": true,
  "remove_tag_liga": false,
  "weight_mapping": {
    "thin": 100,
    "extralight": 225,
    "light": 325,
    "regular": 450,
    "medium": 525,
    "semibold": 625,
    "bold": 715,
    "extrabold": 800
  },
  "codepoint_alias": {},
  "line_height": 1.0,
  "width": "default",
  "feature_freeze": {
    "cv01": "ignore",
    "cv02": "enable",
    "cv03": "enable",
    "cv04": "ignore",
    "cv05": "enable",
    "cv06": "ignore",
    "cv07": "ignore",
    "cv08": "ignore",
    "cv09": "enable",
    "cv10": "enable",
    "cv11": "ignore",
    "cv31": "enable",
    "cv32": "ignore",
    "cv33": "ignore",
    "cv34": "ignore",
    "cv35": "enable",
    "cv36": "ignore",
    "cv37": "ignore",
    "cv38": "enable",
    "cv39": "ignore",
    "cv40": "ignore",
    "cv41": "ignore",
    "cv42": "enable",
    "cv43": "enable",
    "cv44": "ignore",
    "cv61": "ignore",
    "cv62": "ignore",
    "cv63": "enable",
    "cv64": "ignore",
    "cv65": "ignore",
    "cv66": "ignore",
    "cv96": "ignore",
    "cv97": "ignore",
    "cv98": "ignore",
    "cv99": "ignore",
    "ss01": "ignore",
    "ss02": "ignore",
    "ss03": "enable",
    "ss04": "ignore",
    "ss05": "ignore",
    "ss06": "ignore",
    "ss07": "enable",
    "ss08": "enable",
    "ss09": "enable",
    "ss10": "enable",
    "ss11": "enable",
    "zero": "ignore"
  },
  "nerd_font": {
    "enable": true,
    "version": "3.5.0",
    "mono": false,
    "propo": true,
    "use_font_patcher": false,
    "glyphs": [
      "--complete"
    ],
    "extra_args": []
  },
  "cn": {
    "enable": false,
    "with_nerd_font": true,
    "fix_meta_table": true,
    "clean_cache": false,
    "narrow": false,
    "use_hinted": false,
    "use_static_base_font": true,
    "scale_factor": 1.0
  }
}
